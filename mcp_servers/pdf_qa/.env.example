# Port this MCP server listens on.
PORT=8103
# Folder where the backend saves uploaded PDFs (default: <project>/data/uploads).
# UPLOAD_DIR=
# Ollama server and model used to embed chunks and questions.
OLLAMA_URL=http://localhost:11434
EMBED_MODEL=nomic-embed-text
# Qdrant vector database (start it with vector_db/docker-compose.yml).
QDRANT_URL=http://localhost:6333
QDRANT_COLLECTION=pdf_chunks
