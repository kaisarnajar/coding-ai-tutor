# Copy to backend/.env and adjust as needed.
# Changes to the model settings apply on the next question; no restart needed.

# --- Which model answers --------------------------------------------------
# LLM_PROVIDER=ollama : a model served by Ollama (local, or an Ollama ":cloud" model)
# LLM_PROVIDER=openai : any OpenAI-compatible API (OpenRouter, OpenAI, Groq, LM Studio, ...)
LLM_PROVIDER=ollama
LLM_MODEL=qwen2.5:3b
# Thinking models only (e.g. mimo-v2.6): false = answer right away (faster first word),
# true = think first (slower, better on hard problems). Leave unset for the model's default.
# LLM_THINK=false

# Used when LLM_PROVIDER=ollama
OLLAMA_URL=http://localhost:11434

# Used when LLM_PROVIDER=openai. Example for OpenRouter:
#   LLM_PROVIDER=openai
#   LLM_MODEL=anthropic/claude-sonnet-5.5
API_BASE_URL=https://openrouter.ai/api/v1
API_KEY=

# --- Servers --------------------------------------------------------------
BACKEND_PORT=8000
FRONTEND_ORIGIN=http://localhost:5173
# Comma-separated MCP server URLs the backend uses for tools.
MCP_SERVERS=http://localhost:8101/mcp,http://localhost:8102/mcp,http://localhost:8103/mcp
